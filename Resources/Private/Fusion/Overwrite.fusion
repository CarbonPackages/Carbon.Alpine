prototype(Neos.Neos:Page) {
    carbonIncludeAssetsHead.@process.append = afx`
        {value}
        <Carbon.Alpine:Scripts @if.set={Configuration.setting('Carbon.Alpine.includeOnPage')} />
    `
    head.stylesheets.carbonAlpineCss = Carbon.Alpine:Styles {
        @position = 'after carbonIncludeAssetsSyncCss'
        @if.set = ${Configuration.setting('Carbon.Alpine.includeCSSOnPage')}
    }
}
